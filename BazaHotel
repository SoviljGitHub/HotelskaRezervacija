GO

vw_RezervacijeGostiju 
CREATE VIEW vw_RezervacijeGostiju AS
SELECT 
    r.IdRezervacije,
    r.DatumPrijave,
    r.DatumOdjave,
    r.Cena,
    g.JMBG,
    g.Ime AS Ime,            
    g.Prezime AS Prezime,    
    g.Pol,
    g.BrojTelefona,
    g.Email,
    r.BrojSobe,
    s.TipSobe,
    s.Kapacitet,
    s.CenaPoNoci 
FROM Rezervacija r
INNER JOIN Gost g ON r.JMBG_Gosta = g.JMBG
LEFT JOIN Soba s ON r.BrojSobe = s.BrojSobe;

PROCEDURE
-- DodajGosta  
CREATE PROCEDURE DodajGosta
    @Ime NVARCHAR(50),
    @Prezime NVARCHAR(50),
    @JMBG CHAR(13),
    @Pol NVARCHAR(10),
    @DatumRodjenja DATE,
    @BrojTelefona NVARCHAR(20),
    @Email NVARCHAR(100)
AS
BEGIN
    INSERT INTO Gost (Ime, Prezime, JMBG, Pol, DatumRodjenja, BrojTelefona, Email)
    VALUES (@Ime, @Prezime, @JMBG, @Pol, @DatumRodjenja, @BrojTelefona, @Email);

    RETURN 0;
END;
GO

-- DodajSobu
CREATE PROCEDURE DodajSobu
    @BrojSobe NVARCHAR(10),
    @TipSobe NVARCHAR(30),
    @Kapacitet INT,
    @CenaPoNoci DECIMAL(10,2)
AS
BEGIN
    INSERT INTO Soba (BrojSobe, TipSobe, Kapacitet, CenaPoNoci)
    VALUES (@BrojSobe, @TipSobe, @Kapacitet, @CenaPoNoci);

    RETURN 0;
END;
GO

-- DodajRezervaciju
CREATE PROCEDURE DodajRezervaciju
    @JMBG_Gosta CHAR(13),
    @BrojSobe NVARCHAR(10),
    @DatumPrijave DATE,
    @DatumOdjave DATE,
    @Cena DECIMAL(10,2)
AS
BEGIN
    INSERT INTO Rezervacija (JMBG_Gosta, BrojSobe, DatumPrijave, DatumOdjave, Cena)
    VALUES (@JMBG_Gosta, @BrojSobe, @DatumPrijave, @DatumOdjave, @Cena);

    RETURN 0;
END;
GO

-- IzmeniSobu
CREATE PROCEDURE IzmeniSobu
    @Id INT,
    @BrojSobe NVARCHAR(10),
    @TipSobe NVARCHAR(30),
    @Kapacitet INT,
    @CenaPoNoci DECIMAL(10,2)
AS
BEGIN
    UPDATE Soba
    SET BrojSobe = @BrojSobe,
        TipSobe = @TipSobe,
        Kapacitet = @Kapacitet,
        CenaPoNoci = @CenaPoNoci
    WHERE Id = @Id;

    RETURN 0;
END;
GO

-- ObrisiGosta
CREATE PROCEDURE ObrisiGosta
    @JMBG CHAR(13)
AS
BEGIN
    DELETE FROM Gost WHERE JMBG = @JMBG;

    RETURN 0;
END;
GO

-- ObrisiSobu
CREATE PROCEDURE ObrisiSobu
