  -- PostojiBrojSobe
CREATE OR ALTER PROCEDURE dbo.PostojiBrojSobe
    @BrojSobe NVARCHAR(20)
AS
BEGIN
    SET NOCOUNT ON;

    SELECT CASE 
             WHEN EXISTS (SELECT 1 FROM dbo.Soba WHERE BrojSobe = @BrojSobe) 
             THEN 1 ELSE 0 
           END AS Postoji;
END
GO
  
  -- SobaJeZauzeta
CREATE PROCEDURE dbo.SobaJeZauzeta
    @BrojSobe NVARCHAR(10),
    @DatumOd  DATE,
    @DatumDo  DATE
AS
BEGIN
    SET NOCOUNT ON;

    IF EXISTS (
        SELECT 1
        FROM Rezervacija r
        WHERE r.BrojSobe = @BrojSobe
          AND NOT (@DatumDo <= r.DatumPrijave OR @DatumOd >= r.DatumOdjave)
    )
        SELECT 1;  -- zauzeta
    ELSE
        SELECT 0;  -- slobodna
END
GO

-- VratiSveGoste
CREATE PROCEDURE dbo.VratiSveGoste
AS
BEGIN
    SET NOCOUNT ON;
    SELECT 
        Ime,
        Prezime,
        JMBG,
        Pol,
        DatumRodjenja,
        BrojTelefona AS Telefon, 
        Email
    FROM dbo.Gost
    ORDER BY Prezime, Ime;
END
GO

-- PostojiGost
CREATE PROCEDURE dbo.PostojiGost
    @JMBG CHAR(13),
    @Email NVARCHAR(100) = NULL
AS
BEGIN
    SET NOCOUNT ON;

    IF @Email IS NULL
    BEGIN
        SELECT COUNT(*) AS BrojGostiju
        FROM dbo.Gost
        WHERE JMBG = @JMBG;
    END
    ELSE
    BEGIN
        SELECT COUNT(*) AS BrojGostiju
        FROM dbo.Gost
        WHERE JMBG = @JMBG AND Email = @Email;
    END
END
GO
