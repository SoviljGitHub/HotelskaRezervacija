-- Tabela Gost -- 
CREATE TABLE Gost (
    JMBG CHAR(13) PRIMARY KEY,
    Ime NVARCHAR(50) NOT NULL,
    Prezime NVARCHAR(50) NOT NULL,
    Pol NVARCHAR(10) NOT NULL,
    DatumRodjenja DATE NOT NULL,
    BrojTelefona NVARCHAR(20),
    Email NVARCHAR(100)
);
GO

-- Tabela Soba -- 
CREATE TABLE Soba (
    Id INT PRIMARY KEY IDENTITY(1,1),
    BrojSobe NVARCHAR(10) NOT NULL UNIQUE,
    TipSobe NVARCHAR(30) NOT NULL,
    Kapacitet INT NOT NULL DEFAULT 1,
    CenaPoNoci DECIMAL(10,2) NOT NULL
);
GO



-- Tabela Rezervacija -- 
CREATE TABLE Rezervacija (
    IdRezervacije INT PRIMARY KEY IDENTITY(1,1),
    JMBG_Gosta CHAR(13) NOT NULL,
    BrojSobe NVARCHAR(10) NOT NULL,
    DatumPrijave DATE NOT NULL,
    DatumOdjave DATE NOT NULL,
    Cena DECIMAL(10,2) NOT NULL DEFAULT 0,

    CONSTRAINT FK_Rezervacija_Gost FOREIGN KEY (JMBG_Gosta)
        REFERENCES Gost(JMBG)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    CONSTRAINT FK_Rezervacija_Soba FOREIGN KEY (BrojSobe)
        REFERENCES Soba(BrojSobe)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);
GO




